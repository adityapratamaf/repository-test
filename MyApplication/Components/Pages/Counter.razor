@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using AutomotiveApp.BlazorUI.Models
@page "/counter"

<PageTitle>Counter</PageTitle>

<button @onclick="HandleChipClick">Klik Ini</button>

<MudChip T="string" Color="Color.Primary" @onclick="HandleChipClick">
    Chips Button
</MudChip>

<p>@message</p>

<MudChip T="string" Color="Color.Primary" @onclick="HandleChipClick">
    Chips Button Primary
</MudChip>
<p>@message</p>

@code {
    private string message = " ";

    private void HandleChipClick()
    {
        message = "Sudah di klik";
    }
}

